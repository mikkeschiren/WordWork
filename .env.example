# Word Work – inställningar för docker compose.
# Kopiera till .env och ändra det du behöver: cp .env.example .env
# .env checkas inte in (se .gitignore) – lägg API-nycklar där, inte här.
# Tomma rader eller bortkommenterade värden ger standardvärdet som anges.

# Mapp på datorn där texterna sparas.
WW_DATA_PATH=./data

# Minsta tid (minuter) mellan automatiska versioner i historiken.
WW_SNAPSHOT_MINUTES=5

# Värdnamn som får användas för att nå appen (skydd mot DNS-rebinding).
WW_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# ---- AI-assistent ----
# ollama = Ollamas eget API (rekommenderas: styr kontextfönster och "Tänk efter först").
# openai = OpenAI-kompatibelt API (OpenAI, OpenRouter, vLLM, LM Studio, llama.cpp …).
WW_AI_API=ollama

# Serverns adress. Standard: Ollama på den egna datorn.
# Tom adress (WW_AI_URL=) stänger av AI-stödet.
WW_AI_URL=http://host.docker.internal:11434

# Förvald modell (kan bytas i AI-panelen). Tom = första chattmodellen servern har.
WW_AI_MODEL=

# API-nyckel för tjänster som kräver det. Visas aldrig i webbläsaren.
WW_AI_KEY=
